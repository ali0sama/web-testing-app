# Copy this file to ".env" and fill in your values. ".env" is never committed.

# ---------- Model provider ----------
# "groq" (free-tier cloud API) or "ollama" (local, free)
LLM_PROVIDER=groq

# Groq: create a free key at https://console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ---------- Target website ----------
# The page the assistant opens by default. To switch websites, change this line
# and restart the app. Its host is automatically allowed.
TARGET_URL=https://the-internet.herokuapp.com/login

# Extra hosts the browser may navigate to (comma-separated). Leave empty if none.
EXTRA_ALLOWED_HOSTS=example.com

# ---------- Runner ----------
# Maximum seconds one browser command may take before the runner is restarted.
RUNNER_TIMEOUT_SECONDS=90
